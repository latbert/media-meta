{
  "name": "@nopilot/media-meta-mcp",
  "version": "1.0.0",
  "description": "Local-first MCP server for reading EXIF/XMP metadata from modern image formats: HEIC/HEIF/AVIF (ISOBMFF item metadata) and WebP (RIFF chunks). stdio + Streamable HTTP. Zero network, zero LLM, zero runtime deps in the engine.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "media-meta-mcp": "dist/main.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "server.json",
    "registry.json"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@nopilot/media-meta-engine": "^1.0.0",
    "@nopilot/mcp-server-common": "^0.1.0",
    "zod": "^4.6.7"
  },
  "engines": {
    "node": ">=20.19"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "exif",
    "heic",
    "heif",
    "avif",
    "webp",
    "xmp",
    "image-metadata",
    "model-context-protocol",
    "local-first",
    "offline"
  ],
  "author": "latbert",
  "homepage": "https://github.com/latbert/media-meta#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/latbert/media-meta.git",
    "directory": "packages/media-meta-mcp"
  }
}
